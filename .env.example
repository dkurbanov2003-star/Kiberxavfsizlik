# Bu NAMUNA fayl. Uni nusxalab ".env" nomli fayl yarating
# va o'zingizning haqiqiy tokeningizni qo'ying.
#
# Buyruq (terminalda):  cp .env.example .env
#
# BotFather'dan olgan tokeningizni pastga qo'ying:
BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# (IXTIYORIY) Anonim murojaatlar yuboriladigan mutaxassis chat ID'si.
# Bilmasangiz bo'sh qoldiring — keyinroq sozlaymiz.
ADMIN_CHAT_ID=
